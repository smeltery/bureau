{
  "name": "bureau",
  "type": "module",
  "scripts": {
    "postinstall": "git config core.hooksPath .githooks 2>/dev/null || true",
    "dev": "bash scripts/dev-watch.sh",
    "dev:manual": "bun run build:ui && bun run server/index.ts",
    "build:ui": "bash scripts/build.sh",
    "gen:codex-schemas": "bun run scripts/gen-codex-schemas.ts",
    "demo:build": "bash scripts/build-demo.sh",
    "demo:build:assets": "BUREAU_SKIP_APP_BUILD=1 bash scripts/build-demo.sh",
    "demo": "bun run demo:build && PORT=${PORT:-4001} bun run server/index.ts",
    "build:ui:watch": "bun build ui/index.tsx --outdir ui/dist --production --watch",
    "server:watch": "bun --watch server/index.ts",
    "server": "bun run server/index.ts",
    "doctor": "bun run scripts/doctor.ts",
    "typecheck": "tsc --noEmit",
    "lint": "bun node_modules/oxlint/bin/oxlint --react-plugin server shared ui",
    "budget": "bun run scripts/check-loc-budgets.ts",
    "format": "prettier --write 'server/**/*.{ts,tsx}' 'shared/**/*.{ts,tsx}' 'ui/**/*.{ts,tsx}'",
    "format:check": "prettier --check 'server/**/*.{ts,tsx}' 'shared/**/*.{ts,tsx}' 'ui/**/*.{ts,tsx}'",
    "test": "bun test",
    "check": "bun run typecheck && bun run budget && bun run lint && bun run format:check && bun run test",
    "build:server": "bun build server/index.ts --target bun --outdir /tmp/bureau-server-build --external playwright-core && bun run scripts/license-notices.mjs /tmp/bureau-server-build",
    "ci": "bun run check && bun run build:ui && bun run build:server"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.293",
    "@anthropic-ai/sdk": "^0.100.1",
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "6.42.1",
    "@openai/codex": "0.160.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "diff2html": "^3.4.56",
    "highlight.js": "^11.11.1",
    "katex": "^0.18.7",
    "marked": "^18.0.3",
    "marked-highlight": "^2.2.4",
    "mermaid": "^11.15.0",
    "node-pty": "^1.1.0",
    "playwright-core": "1.62.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "oxlint": "1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  }
}
