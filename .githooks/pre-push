#!/usr/bin/env bash
# Runs the exact CI gate (`bun run ci`: check, UI build, server build) so a
# push that passes here passes on GitHub.
# Bypass with `git push --no-verify` only after deciding the push is safe.
#
# Preserve the full output because the gate can take a while and push wrappers
# may only report the exit code. Keeping the log avoids a second full run just
# to see the failing step.
set -e

LOG_FILE="${TMPDIR:-/tmp}/bureau-pre-push-$(date +%Y%m%dT%H%M%S).log"

echo "→ bun run ci (the exact GitHub gate)"
echo "  full output: $LOG_FILE"

set +e
bun run ci 2>&1 | tee "$LOG_FILE"
status=${PIPESTATUS[0]}
set -e

if [[ $status -ne 0 ]]; then
  echo "✗ bun run ci failed (exit $status). Full output: $LOG_FILE"
fi
exit "$status"
