{
  "name": "@bureau/website",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Marketing website for bureau — your agent office",
  "scripts": {
    "dev": "vite --port 3006",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview --port 3006",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "og": "rsvg-convert -w 1200 -h 630 public/og.svg -o public/og.png",
    "ci": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.4"
  }
}
